---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../../../i18n/translations';
import { catalogImages } from '../../../data/catalog';

type CategoryKey = keyof typeof catalogImages;

export function getStaticPaths() {
  return Object.keys(catalogImages).map((key) => ({
    params: { categoria: key },
  }));
}

const { categoria } = Astro.params;
const lang = 'en';
const t = useTranslations(lang);
const categoryKey = categoria as CategoryKey;

const images = catalogImages[categoryKey] as readonly string[];

const emojiMap: Record<CategoryKey, string> = {
  ramos: '💐', centros: '🌺', bodas: '🤍', plantas: '🪴', coronas: '🌿', florseca: '🌾', eventos: '✨',
};
const emoji = emojiMap[categoryKey];
const categoryName = t(`catalog.${categoryKey}`);
const metaDescriptions: Record<CategoryKey, string> = {
  ramos: 'Custom flower bouquets in Torrevieja, made by Artemisa Floristas with seasonal flowers.',
  centros: 'Custom floral centrepieces for gifts, decoration and celebrations, made by Artemisa Floristas in Torrevieja.',
  bodas: 'Bridal bouquets and floral decoration for weddings in Torrevieja and Orihuela Costa.',
  plantas: 'Indoor and outdoor plants available from Artemisa Floristas in central Torrevieja.',
  coronas: 'Funeral wreaths and arrangements prepared with respect and care in Torrevieja.',
  florseca: 'Dried and preserved flower bouquets and centrepieces by Artemisa Floristas in Torrevieja.',
  eventos: 'Floral decoration for events, communions and celebrations in Torrevieja and Orihuela Costa.',
};
---

<Layout
  title={`${categoryName} in Torrevieja · Artemisa Floristas`}
  description={metaDescriptions[categoryKey]}
>

  <section class="max-w-6xl mx-auto px-6 py-20">
    <a
      href={getLocalizedPath('/catalogo', lang)}
      class="inline-flex items-center gap-2 text-sm text-stone-400 hover:text-[#2d5a3d] transition-colors mb-10"
    >
      ← {t('nav.catalog')}
    </a>

    <div class="flex items-center gap-3 mb-12">
      <span class="text-4xl">{emoji}</span>
      <h1 class="text-4xl font-light text-[#1a1a1a]">{categoryName}</h1>
    </div>

    {images.length > 0
      ? (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {images.map((src, index) => (
            <div class="aspect-square overflow-hidden rounded-xl bg-stone-100">
              <img
                src={src}
                alt={`${categoryName} by Artemisa Floristas in Torrevieja — example ${index + 1}`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      )
      : (
        <div class="text-center py-20 text-stone-300">
          <p class="text-5xl mb-4">📷</p>
          <p class="text-sm">Coming soon</p>
        </div>
      )
    }
  </section>

  <section class="bg-[#2d5a3d] text-white py-20 text-center">
    <h2 class="text-3xl font-light mb-4">{t('catalog.cta')}</h2>
    <p class="text-green-200 mb-8">{t('catalog.cta.sub')}</p>
    <a
      href={getLocalizedPath('/contacto', lang)}
      class="inline-block bg-white text-[#2d5a3d] px-8 py-3 rounded-full text-sm font-medium hover:bg-green-50 transition-colors"
    >
      {t('nav.contact')}
    </a>
  </section>

</Layout>
