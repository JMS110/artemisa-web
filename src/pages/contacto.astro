---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/translations';

const lang = 'es';
const t = useTranslations(lang);
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Artemisa+Floristas+Calle+Zoa+55+03182+Torrevieja';
---

<Layout
  title="Contacto y horario · Artemisa Floristas Torrevieja"
  description="Contacta con Artemisa Floristas en Calle Zoa, 55, Torrevieja. Consulta nuestro horario y llámanos para encargar flores o solicitar reparto."
>

  <section class="max-w-5xl mx-auto px-6 py-20">
    <h1 class="text-4xl font-light text-center text-[#1a1a1a] mb-2">{t('contact.title')}</h1>
    <p class="text-center text-stone-400 mb-16">{t('contact.subtitle')}</p>

    <div class="grid md:grid-cols-2 gap-12">

      <!-- Info -->
      <div class="space-y-6">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-[#2d5a3d] mb-2">{t('contact.phone')}</h3>
          <p class="text-stone-700">
            <a href="tel:+34965711243" class="hover:text-[#2d5a3d]">965 711 243</a><br />
            <a href="tel:+34633501113" class="hover:text-[#2d5a3d]">633 501 113</a>
          </p>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-[#2d5a3d] mb-2">{t('contact.address')}</h3>
          <p class="text-stone-700">C/ Zoa, 55 (esq. C/ Antonio Machado)<br />03182 Torrevieja, Alicante</p>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-[#2d5a3d] mb-2">{t('contact.hours')}</h3>
          <p class="text-stone-700 leading-relaxed">
            {t('hours.weekdays')}<br />
            {t('hours.saturday')}<br />
            {t('hours.summer')}<br />
            {t('hours.sunday')}
          </p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-6">
          <p class="text-sm text-stone-500 mb-4">Estamos en el centro de Torrevieja, en la esquina con la calle Antonio Machado.</p>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full border border-[#2d5a3d] px-5 py-2.5 text-sm font-medium text-[#2d5a3d] hover:bg-green-50 transition-colors"
          >
            {t('contact.maps')} ↗
          </a>
        </div>
      </div>

      <div class="rounded-2xl bg-[#2d5a3d] p-8 text-white self-start">
        <h2 class="text-2xl font-light mb-3">{t('contact.order.title')}</h2>
        <p class="text-green-100 mb-8">{t('contact.order.subtitle')}</p>
        <div class="space-y-3">
          <a href="tel:+34965711243" class="block w-full rounded-full bg-white px-5 py-3 text-center text-sm font-medium text-[#2d5a3d] hover:bg-green-50 transition-colors">
            {t('contact.call.landline')}
          </a>
          <a href="tel:+34633501113" class="block w-full rounded-full border border-green-200 px-5 py-3 text-center text-sm font-medium text-white hover:bg-white/10 transition-colors">
            {t('contact.call.mobile')}
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
