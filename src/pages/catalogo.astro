---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/translations';

const lang = 'es';
const t = useTranslations(lang);

const categories = [
  { key: 'ramos',   emoji: '💐', description: 'Ramos para regalar o decorar, elaborados con flores de temporada.' },
  { key: 'centros', emoji: '🌺', description: 'Centros de mesa para el hogar, oficinas y celebraciones.' },
  { key: 'bodas',   emoji: '🤍', description: 'Ramos de novia, decoración floral y arreglos para tu día especial.' },
  { key: 'plantas', emoji: '🪴', description: 'Plantas de interior y exterior, macetas y jardines verticales.' },
  { key: 'coronas', emoji: '🌿', description: 'Coronas y arreglos fúnebres elaborados con respeto y cuidado.' },
  { key: 'eventos', emoji: '✨', description: 'Decoración floral para eventos, comuniones, cumpleaños y más.' },
] as const;
---

<Layout title={t('nav.catalog')}>

  <section class="max-w-6xl mx-auto px-6 py-20">
    <h1 class="text-4xl font-light text-center text-[#1a1a1a] mb-2">{t('catalog.title')}</h1>
    <p class="text-center text-stone-400 mb-16">{t('catalog.subtitle')}</p>

    <div class="space-y-20">
      {categories.map(({ key, emoji, description }) => (
        <div id={key} class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-8">
            <span class="text-3xl">{emoji}</span>
            <h2 class="text-2xl font-light text-[#1a1a1a]">{t(`catalog.${key}`)}</h2>
          </div>
          <p class="text-stone-500 mb-8 max-w-xl">{description}</p>
          <!-- Photo grid — las fotos las añadirá Rebeca -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {[1,2,3,4].map(() => (
              <div class="aspect-square bg-stone-100 rounded-xl flex items-center justify-center text-stone-300 text-sm">
                📷
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-[#2d5a3d] text-white py-20 text-center">
    <h2 class="text-3xl font-light mb-4">{t('catalog.cta')}</h2>
    <p class="text-green-200 mb-8">{t('catalog.cta.sub')}</p>
    <a
      href={getLocalizedPath('/contacto', lang)}
      class="inline-block bg-white text-[#2d5a3d] px-8 py-3 rounded-full text-sm font-medium hover:bg-green-50 transition-colors"
    >
      {t('nav.contact')}
    </a>
  </section>

</Layout>
