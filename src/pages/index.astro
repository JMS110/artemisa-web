---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/translations';

const lang = 'es';
const t = useTranslations(lang);

const categories = [
  { key: 'ramos',   emoji: '💐' },
  { key: 'centros', emoji: '🌺' },
  { key: 'bodas',   emoji: '🤍' },
  { key: 'plantas', emoji: '🪴' },
  { key: 'coronas', emoji: '🌿' },
  { key: 'eventos', emoji: '✨' },
] as const;
---

<Layout title="Inicio">

  <!-- Hero -->
  <section class="relative min-h-[80vh] flex items-center justify-center text-center overflow-hidden bg-[#f0ece4]">
    <div class="relative z-10 max-w-2xl mx-auto px-6 py-24">
      <p class="text-[#2d5a3d] text-sm font-medium tracking-widest uppercase mb-4">
        Floristería Artemisa · Torrevieja
      </p>
      <h1 class="text-5xl md:text-6xl font-light text-[#1a1a1a] leading-tight mb-6">
        {t('hero.tagline')}
      </h1>
      <p class="text-stone-500 text-lg mb-10">
        {t('hero.subtitle')}
      </p>
      <a
        href={getLocalizedPath('/catalogo', lang)}
        class="inline-block bg-[#2d5a3d] text-white px-8 py-3 rounded-full text-sm font-medium hover:bg-[#1e3f2a] transition-colors"
      >
        {t('hero.cta')}
      </a>
      <p class="mt-6 text-sm text-stone-400">{t('delivery')}</p>
    </div>
    <div class="absolute top-10 left-10 w-40 h-40 rounded-full bg-[#d4b896]/20 blur-2xl"></div>
    <div class="absolute bottom-10 right-10 w-64 h-64 rounded-full bg-[#2d5a3d]/10 blur-3xl"></div>
  </section>

  <!-- Categories -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-3xl font-light text-center text-[#1a1a1a] mb-2">{t('catalog.title')}</h2>
    <p class="text-center text-stone-400 mb-12">{t('catalog.subtitle')}</p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {categories.map(({ key, emoji }) => (
        <a
          href={`${getLocalizedPath('/catalogo', lang)}#${key}`}
          class="group bg-white rounded-2xl p-8 text-center hover:shadow-md transition-all hover:-translate-y-1 border border-stone-100"
        >
          <div class="text-4xl mb-3">{emoji}</div>
          <h3 class="text-sm font-medium text-stone-700 group-hover:text-[#2d5a3d] transition-colors">
            {t(`catalog.${key}`)}
          </h3>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#2d5a3d] text-white py-20 text-center">
    <h2 class="text-3xl font-light mb-4">{t('catalog.cta')}</h2>
    <p class="text-green-200 mb-8">{t('catalog.cta.sub')}</p>
    <a
      href={getLocalizedPath('/contacto', lang)}
      class="inline-block bg-white text-[#2d5a3d] px-8 py-3 rounded-full text-sm font-medium hover:bg-green-50 transition-colors"
    >
      {t('nav.contact')}
    </a>
  </section>

</Layout>
